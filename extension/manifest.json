{
    "manifest_version": 3,
    "name": "Read Later",
    "version": "0.1.0",
    "description": "Save links to your local Read Later API",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "http://127.0.0.1:8000/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Save to Read Later"
    }
}